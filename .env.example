# Copy to .env for local development (the server loads ../.env automatically).

# --- Database (PostgreSQL) ---
# Local: `docker compose up -d db` matches this default.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lms
# AWS RDS: set true (and optionally DATABASE_SSL_CA_FILE=/path/to/global-bundle.pem to verify the certificate)
DATABASE_SSL=false

# --- Security ---
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
SESSION_HOURS=8
# Shift windows, reminders and report dates use this timezone
APP_TIMEZONE=Asia/Kolkata
# Public address of the app: used for links in emails
APP_URL=http://localhost:5173

# --- Video: Bunny Stream (see docs/BUNNY.md). Leave empty and video features stay off. ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_CDN_HOSTNAME=            # e.g. vz-1234abcd-xyz.b-cdn.net
BUNNY_TOKEN_KEY=               # the pull zone's URL Token Authentication Key
# BUNNY_TOKEN_TTL_SECONDS=600  # access removal / shift end stops a playing video within about this long

# --- Email: Brevo SMTP (see docs/EMAIL.md). Leave empty and email stays off. ---
SMTP_USER=                     # Brevo SMTP login
SMTP_PASS=                     # Brevo SMTP key (not an API key)
MAIL_FROM="Staff Training <training@yourcompany.com>"
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# REMINDERS_ENABLED=true

# --- PDFs and images: object storage ---
# local = files on this machine's disk (development only); s3 = private S3 bucket (production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
# S3_BUCKET=my-company-lms-media
# AWS_REGION=ap-south-1      # credentials come from the ECS task role; never put access keys here
# S3_ENDPOINT=http://localhost:9000   # only for MinIO/LocalStack in development (add S3_FORCE_PATH_STYLE=true)

# --- Optional tuning ---
# PORT=3000
# MAX_UPLOAD_MB=1024
# LOGIN_FAILURES_PER_ACCOUNT=10
# LOGIN_FAILURES_PER_IP=50
# AUTO_MIGRATE=true
