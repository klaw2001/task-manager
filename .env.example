# ─── Required in production ────────────────────────────────────────────────
# Postgres connection string (Neon / Vercel Postgres / Supabase / any Postgres).
# Leave empty in local dev to use an embedded database stored in ./.data
DATABASE_URL=

# Random 32+ char secret used to sign session cookies.
#   openssl rand -base64 48
AUTH_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────
# If set, the first-run /setup page asks for this key. Protects a freshly
# deployed instance from being claimed by a stranger before you do.
SETUP_KEY=

# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/overdue. Vercel sets the header automatically when this var exists.
CRON_SECRET=
